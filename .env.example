ENVIRONMENT=development
DEBUG=false
APP_PUBLIC_URL=http://localhost:8000

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE

META_GRAPH_API_VERSION=v23.0

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=replace-me
WHATSAPP_PHONE_NUMBER_ID=replace-me
WHATSAPP_VERIFY_TOKEN=replace-me
WHATSAPP_APP_SECRET=replace-me

# Instagram Messaging API
INSTAGRAM_PAGE_ACCESS_TOKEN=replace-me
INSTAGRAM_USER_ID=replace-me
INSTAGRAM_VERIFY_TOKEN=replace-me
INSTAGRAM_APP_SECRET=replace-me

# Grounded answers from PostgreSQL knowledge_entries
GROQ_API_KEY=replace-me
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.1
GROQ_MAX_COMPLETION_TOKENS=1024
GROQ_TOP_P=1
GROQ_REASONING_EFFORT=low
GROQ_DISABLE_SSL_VERIFY=false

API_KEY=change-this
CORS_ORIGINS=
