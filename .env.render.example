# Render service
ENVIRONMENT=production
DEBUG=false
APP_PUBLIC_URL=https://YOUR-SERVICE-NAME.onrender.com

# Existing Neon PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Meta Graph API
META_GRAPH_API_VERSION=v25.0

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=PASTE_PERMANENT_SYSTEM_USER_TOKEN
WHATSAPP_PHONE_NUMBER_ID=PASTE_PHONE_NUMBER_ID
WHATSAPP_VERIFY_TOKEN=CREATE_A_LONG_RANDOM_VERIFY_TOKEN
WHATSAPP_APP_SECRET=PASTE_META_APP_SECRET

# Instagram Messaging API
INSTAGRAM_PAGE_ACCESS_TOKEN=PASTE_LONG_LIVED_PAGE_ACCESS_TOKEN
INSTAGRAM_USER_ID=PASTE_INSTAGRAM_PROFESSIONAL_ACCOUNT_ID
INSTAGRAM_VERIFY_TOKEN=CREATE_ANOTHER_LONG_RANDOM_VERIFY_TOKEN
INSTAGRAM_APP_SECRET=PASTE_META_APP_SECRET

# Groq
GROQ_API_KEY=PASTE_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_MAX_COMPLETION_TOKENS=512
GROQ_TOP_P=1
GROQ_REASONING_EFFORT=low
GROQ_DISABLE_SSL_VERIFY=false

# Protected internal API
API_KEY=CREATE_A_LONG_RANDOM_INTERNAL_API_KEY
CORS_ORIGINS=
